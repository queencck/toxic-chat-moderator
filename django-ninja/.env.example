# Django API service. Copy to .env and fill in.
# Self-sufficient: `manage.py` loads this directly via load_dotenv(),
# and docker compose passes it in via env_file.

# --- database (DB_HOST is overridden to `db` by docker-compose) ---
DB_NAME=toxic_moderator
DB_USER=postgres
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432

# --- app ---
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-me
# Shared secret the Discord bot authenticates with. Must match bot-services/.env
SECRET_TOKEN=replace-me
ML_MODEL_SERVER_URL=localhost:8080
